  // ① Cloudflare에 있는 Worker 이름과 똑같이 적으세요 (영문 소문자·숫자·-)
  "name": "여기에-워커-이름",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SCHEDULE",
      // ② Workers KV에서 만든 family-schedule의 ID를 붙여넣으세요
      "id": "여기에-KV-ID"
    }
  ]
}
