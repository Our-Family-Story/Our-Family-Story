<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>우리집 픽업 보드</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gaegu:wght@700&family=IBM+Plex+Sans+KR:wght@400;500;600&display=swap">
<style>
:root{
  --paper:#F5F7F2; --card:#FFFFFF; --ink:#1E3328; --muted:#5E6F64; --line:#D9E0D6;
  --bus:#F2B705; --bus-ink:#3A2C00; --done:#2E8B57;
  --display:"Gaegu","IBM Plex Sans KR",cursive;
  --body:"IBM Plex Sans KR",system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){:root{
  --paper:#131B16; --card:#1B2620; --ink:#E6EEE8; --muted:#9DB0A3; --line:#2C3A31;
  --bus:#F5C334; --bus-ink:#2A2000; --done:#5CC08A; color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.55}
.wrap{max-width:1100px;margin:0 auto;padding:28px max(16px,env(safe-area-inset-right)) 56px max(16px,env(safe-area-inset-left));display:grid;gap:36px}
h1,h2{font-family:var(--display);font-weight:700;margin:0;line-height:1.15}
h1{font-size:clamp(34px,6vw,52px)} h2{font-size:28px}
.eyebrow{font-size:12px;letter-spacing:.08em;color:var(--muted);font-weight:600}
header{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:12px 24px;border-bottom:2px dashed var(--line);padding-bottom:20px}
.date,.sub{color:var(--muted);font-variant-numeric:tabular-nums}
.sub{font-size:13px}
.today{display:grid;gap:14px}
.today-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 14px}
.today-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.ticket{background:var(--bus);color:var(--bus-ink);border-radius:14px;padding:16px 18px;display:grid;gap:6px}
.ticket .t{font-size:30px;font-weight:600;font-variant-numeric:tabular-nums;line-height:1}
.ticket.is-done{background:var(--card);color:var(--muted);border:1px solid var(--line)}
.ticket.is-done .t{text-decoration:line-through}
.done-btn{justify-self:start;margin-top:6px;border:1.5px solid currentColor;background:transparent;color:inherit;border-radius:999px;padding:4px 12px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.ticket.is-done .done-btn{color:var(--done)}
.empty{color:var(--muted);padding:14px 0}
.week-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.dot{width:10px;height:10px;border-radius:50%;display:inline-block;background:var(--kc)}
.week{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}
.day{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;display:grid;align-content:start;gap:8px;min-width:0}
.day.is-today{border:2px solid var(--bus)}
.day h3{margin:0;font-size:15px;display:flex;justify-content:space-between}
.day h3 small{font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}
.slot{padding:8px 10px;border-left:4px solid var(--kc);border-radius:4px;display:grid;gap:1px}
.slot .time{font-weight:600;font-variant-numeric:tabular-nums}
.slot .kid{font-size:13px;color:var(--kc);font-weight:600}
.slot .meta{font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.none{font-size:13px;color:var(--muted)}
@media (max-width:760px){.week{grid-template-columns:1fr}}
.notes ul{list-style:none;padding:0;margin:12px 0 0}
.notes li{padding:10px 0;border-bottom:1px solid var(--line)}
footer{color:var(--muted);font-size:13px}
:focus-visible{outline:3px solid var(--bus);outline-offset:2px}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <div class="eyebrow" id="family">우리 가족 홈</div>
      <h1>우리집 픽업 보드</h1>
    </div>
    <div style="text-align:right">
      <div class="date" id="todayLabel"></div>
    </div>
  </header>

  <section class="today">
    <div class="today-head"><h2 id="todayTitle">오늘 픽업</h2><span class="sub" id="todaySub"></span></div>
    <div class="today-list" id="todayList"><div class="empty">불러오는 중…</div></div>
  </section>

  <section>
    <div class="week-head"><h2>주간 픽업 스케줄</h2><div class="legend" id="legend"></div></div>
    <div class="week" id="week"></div>
  </section>

  <section class="notes"><h2>가족 메모</h2><ul id="notes"></ul></section>

  <footer>"픽업 완료" 표시는 이 기기에만 저장됩니다. 스케줄은 GitHub의 schedule.json에서 고치세요.</footer>
</div>

<script>
const DAYS=["일","월","화","수","목","금","토"];
const pad=n=>String(n).padStart(2,"0");
const iso=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const now=new Date(), dow=now.getDay(), weekend=dow===0||dow===6;
document.getElementById("todayLabel").textContent=`${now.getFullYear()}년 ${now.getMonth()+1}월 ${now.getDate()}일 ${DAYS[dow]}요일`;

const monday=new Date(now); monday.setDate(now.getDate()+(dow===0?1:dow===6?2:1-dow));
const week=[0,1,2,3,4].map(i=>{const d=new Date(monday);d.setDate(monday.getDate()+i);return d});

function loadDone(){try{return JSON.parse(localStorage.getItem("pickupDone")||"{}")}catch(e){return {}}}
function saveDone(v){try{localStorage.setItem("pickupDone",JSON.stringify(v))}catch(e){}}
let done=loadDone(), data=null;

function render(){
  const color=Object.fromEntries(data.kids.map(k=>[k.name,k.color]));
  const kc=n=>color[n]||"var(--muted)";
  document.getElementById("family").textContent=(data.familyName||"우리")+" 가족 홈";
  document.getElementById("legend").innerHTML=data.kids.map(k=>`<span style="--kc:${esc(k.color)}"><i class="dot"></i>${esc(k.name)} · ${esc(k.grade||"")}</span>`).join("");
  const byTime=(a,b)=>a.time.localeCompare(b.time);

  const focusDay=weekend?"월":DAYS[dow], focusDate=weekend?week[0]:now, key=iso(focusDate);
  document.getElementById("todayTitle").textContent=weekend?"다음 픽업 · 월요일":"오늘 픽업";
  const list=data.pickups.filter(p=>p.day===focusDay).sort(byTime);
  document.getElementById("todaySub").textContent=list.length?`${list.length}건 · ${focusDate.getMonth()+1}/${focusDate.getDate()}`:"";
  document.getElementById("todayList").innerHTML=list.length?list.map(p=>{
    const id=`${key}|${p.time}|${p.kid}`, d=!weekend&&done[id];
    return `<article class="ticket${d?" is-done":""}">
      <div class="t">${esc(p.time)}</div>
      <div><b>${esc(p.kid)}</b> · ${esc(p.place||"장소 미정")}</div>
      ${p.note?`<div style="font-size:13px">${esc(p.note)}</div>`:""}
      ${weekend?"":`<button class="done-btn" data-id="${esc(id)}">${d?"✓ 픽업 완료":"픽업 완료 표시"}</button>`}
    </article>`}).join(""):`<div class="empty">${weekend?"월요일":"오늘"}은 예정된 픽업이 없어요.</div>`;

  document.getElementById("week").innerHTML=["월","화","수","목","금"].map((d,i)=>{
    const items=data.pickups.filter(p=>p.day===d).sort(byTime);
    return `<div class="day${!weekend&&DAYS[dow]===d?" is-today":""}">
      <h3>${d}요일 <small>${week[i].getMonth()+1}/${week[i].getDate()}</small></h3>
      ${items.length?items.map(p=>`<div class="slot" style="--kc:${esc(kc(p.kid))}">
        <span class="time">${esc(p.time)}</span><span class="kid">${esc(p.kid)}</span>
        <span class="meta">${esc(p.place||"")}</span>${p.note?`<span class="meta">${esc(p.note)}</span>`:""}
      </div>`).join(""):`<span class="none">픽업 없음</span>`}
    </div>`}).join("");

  document.getElementById("notes").innerHTML=(data.notes||[]).map(n=>`<li>${esc(n)}</li>`).join("")||`<li class="none">메모 없음</li>`;
}

document.addEventListener("click",e=>{
  const b=e.target.closest(".done-btn"); if(!b) return;
  const id=b.dataset.id; if(done[id]) delete done[id]; else done[id]=true;
  saveDone(done); render();
});

fetch("schedule.json",{cache:"no-store"}).then(r=>r.json()).then(j=>{data=j;render()})
  .catch(()=>{document.getElementById("todayList").innerHTML='<div class="empty">schedule.json을 읽지 못했어요. 파일 형식(쉼표, 따옴표)을 확인해주세요.</div>'});
</script>
</body>
</html>
